# Папки для индексации (через точку с запятой)
INDEX_FOLDERS=C:\git\MyProject;C:\git\wiki

# Где хранить индекс (создастся автоматически)
CHROMA_PATH=C:\git\rag_index

# Имя коллекции (любое)
COLLECTION_NAME=my_project

# Размер чанка и перекрытие (в символах)
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Размер батча для эмбеддинга (чанков за один запрос к Ollama)
BATCH_SIZE=200

# Язык стеммера для BM25 (russian, english, german, french, ...)
STEMMER_LANG=russian

# Вес вектора в гибридном поиске (0.0 = только BM25, 1.0 = только вектор)
# Для английского: 0.5 (nomic-embed-text хорошо работает)
# Для русского:    0.3 (nomic-embed-text плохо работает с русским)
VECTOR_WEIGHT=0.5

# Модель LLM (не нужна для LITE-версии)
# LLM_MODEL=qwen2.5:3b

# Адрес Ollama
# OLLAMA_HOST=http://localhost:11434
